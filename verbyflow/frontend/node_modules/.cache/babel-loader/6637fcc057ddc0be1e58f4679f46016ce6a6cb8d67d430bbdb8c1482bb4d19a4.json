{"ast":null,"code":"export default {\n  name: 'Call',\n  data() {\n    return {\n      callId: null,\n      isCallActive: false,\n      showJoinScreen: true,\n      selectedLanguage: '',\n      targetLanguages: {},\n      transcription: '',\n      translations: [],\n      audioLevels: {\n        input: 0,\n        output: 0\n      },\n      error: null,\n      loading: false\n    };\n  },\n  computed: {\n    currentUser() {\n      return this.$store.getters['user/currentUser'];\n    },\n    availableLanguages() {\n      return this.$store.getters['user/availableLanguages'];\n    },\n    currentCall() {\n      return this.$store.getters['call/currentCall'];\n    },\n    participants() {\n      return this.$store.getters['call/participants'];\n    },\n    messages() {\n      return this.$store.getters['call/messages'];\n    },\n    isAuthenticated() {\n      return this.$store.getters['user/isAuthenticated'];\n    },\n    isRecording() {\n      return this.$store.getters['audio/isRecording'];\n    },\n    isMuted() {\n      return this.$store.getters['audio/isMuted'];\n    }\n  },\n  created() {\n    // Load available languages if not already loaded\n    if (!Object.keys(this.availableLanguages || {}).length) {\n      this.$store.dispatch('user/fetchAvailableLanguages');\n    }\n\n    // Create a user if none exists\n    this.ensureUserExists();\n\n    // Set initial language to user's preferred language\n    if (this.currentUser) {\n      this.selectedLanguage = this.currentUser.preferred_language || 'en';\n    }\n\n    // Check if we have a call ID in the route params\n    const {\n      id\n    } = this.$route.params;\n    if (id) {\n      this.callId = id;\n      this.joinCall(id);\n    }\n  },\n  methods: {\n    /**\r\n     * Ensures a user exists before creating/joining a call\r\n     */\n    async ensureUserExists() {\n      if (!this.isAuthenticated) {\n        try {\n          console.log('Creating new user...');\n          // Create a default user\n          await this.$store.dispatch('user/createUser', {\n            name: 'User_' + Math.floor(Math.random() * 1000),\n            preferredLanguage: 'en'\n          });\n          // Make sure the user was created before trying to access properties\n          if (this.currentUser) {\n            console.log('User created successfully:', this.currentUser);\n            this.selectedLanguage = this.currentUser.preferred_language || 'en';\n          } else {\n            console.warn('User creation seemed to succeed but no user object is available');\n          }\n        } catch (error) {\n          console.error('Error creating user:', error);\n          this.$store.dispatch('notification/add', {\n            type: 'error',\n            message: 'Failed to create user profile: ' + (error.message || 'Unknown error')\n          });\n        }\n      } else {\n        console.log('User already exists:', this.currentUser);\n      }\n    },\n    async createNewCall() {\n      try {\n        this.error = null;\n        this.loading = true;\n\n        // Ensure user is created before proceeding\n        await this.ensureUserExists();\n\n        // Create a new call via store\n        const call = await this.$store.dispatch('call/createCall');\n        this.callId = call.id;\n\n        // Redirect to the call page with ID if not already there\n        if (this.$route.params.id !== call.id) {\n          this.$router.push(`/call/${call.id}`);\n        }\n\n        // Set up audio for the call\n        this.isCallActive = true;\n        this.$store.dispatch('audio/setupWebSocket', {\n          callId: call?.id,\n          userId: this.currentUser?.id\n        });\n\n        // Show success notification\n        this.$store.dispatch('notification/add', {\n          type: 'success',\n          message: 'Call created successfully! Share the Call ID with others.'\n        });\n      } catch (error) {\n        console.error('Error creating call:', error);\n        this.error = 'Failed to create call. Please try again.';\n        this.$store.dispatch('notification/add', {\n          type: 'error',\n          message: 'Failed to create call: ' + (error.message || 'Unknown error')\n        });\n      } finally {\n        this.loading = false;\n      }\n    },\n    async joinCall(id) {\n      try {\n        this.error = null;\n        this.loading = true;\n        const callId = id || this.callId;\n        if (!callId) {\n          this.error = 'Please enter a valid Call ID';\n          return;\n        }\n\n        // Ensure user is created before proceeding\n        await this.ensureUserExists();\n\n        // Join the call via store\n        await this.$store.dispatch('call/joinCall', callId);\n\n        // Set up audio for the call\n        this.isCallActive = true;\n        this.$store.dispatch('audio/setupWebSocket', {\n          callId: callId,\n          userId: this.currentUser?.id\n        });\n\n        // Show success notification\n        this.$store.dispatch('notification/add', {\n          type: 'success',\n          message: 'Joined call successfully!'\n        });\n      } catch (error) {\n        console.error('Error joining call:', error);\n        this.error = 'Failed to join call. Please check the Call ID and try again.';\n        this.$store.dispatch('notification/add', {\n          type: 'error',\n          message: 'Failed to join call: ' + (error.message || 'Unknown error')\n        });\n      } finally {\n        this.loading = false;\n      }\n    },\n    leaveCall() {\n      // Clean up audio resources\n      this.$store.dispatch('audio/cleanupAudio');\n\n      // Clear call state\n      this.$store.dispatch('call/leaveCall');\n\n      // Reset local state\n      this.isCallActive = false;\n      this.showJoinScreen = true;\n\n      // Go back to home page\n      this.$router.push('/');\n    },\n    toggleRecording() {\n      if (this.isRecording) {\n        this.$store.dispatch('audio/stopRecording');\n      } else {\n        this.$store.dispatch('audio/startRecording');\n      }\n    },\n    toggleMute() {\n      this.$store.dispatch('audio/toggleMute');\n    },\n    changeLanguage(event) {\n      const language = event.target.value;\n      this.$store.dispatch('user/updateUserLanguage', language);\n    },\n    getLanguageName(code) {\n      return this.availableLanguages[code] || code;\n    },\n    getSenderName(senderId) {\n      if (senderId === this.currentUser?.id) {\n        return 'You';\n      }\n      const participant = this.participants.find(p => p.id === senderId);\n      return participant ? participant.name : 'Unknown User';\n    },\n    formatTime(timestamp) {\n      const date = new Date(timestamp);\n      return date.toLocaleTimeString([], {\n        hour: '2-digit',\n        minute: '2-digit'\n      });\n    },\n    copyCallId() {\n      if (this.currentCall || this.callId) {\n        navigator.clipboard.writeText(this.currentCall?.id || this.callId || '').then(() => {\n          // Show temporary notification\n          this.$store.dispatch('notification/add', {\n            type: 'success',\n            message: 'Call ID copied to clipboard!'\n          });\n        }).catch(error => {\n          console.error('Error copying to clipboard:', error);\n          this.$store.dispatch('notification/add', {\n            type: 'error',\n            message: 'Failed to copy Call ID'\n          });\n        });\n      }\n    }\n  }\n};","map":{"version":3,"names":["name","data","callId","isCallActive","showJoinScreen","selectedLanguage","targetLanguages","transcription","translations","audioLevels","input","output","error","loading","computed","currentUser","$store","getters","availableLanguages","currentCall","participants","messages","isAuthenticated","isRecording","isMuted","created","Object","keys","length","dispatch","ensureUserExists","preferred_language","id","$route","params","joinCall","methods","console","log","Math","floor","random","preferredLanguage","warn","type","message","createNewCall","call","$router","push","userId","leaveCall","toggleRecording","toggleMute","changeLanguage","event","language","target","value","getLanguageName","code","getSenderName","senderId","participant","find","p","formatTime","timestamp","date","Date","toLocaleTimeString","hour","minute","copyCallId","navigator","clipboard","writeText","then","catch"],"sources":["C:\\Users\\Jarvis\\Documents\\verby\\verbyflow\\frontend\\src\\views\\Call.vue"],"sourcesContent":["<template>\r\n  <div class=\"call-container\">\r\n    <!-- Call Setup Section (before joining a call) -->\r\n    <div v-if=\"!isCallActive\" class=\"call-setup\">\r\n      <h1>VerbyFlow Call</h1>\r\n      \r\n      <div class=\"card setup-card\">\r\n        <h2>Start or Join a Call</h2>\r\n        \r\n        <div v-if=\"error\" class=\"error-banner\">\r\n          {{ error }}\r\n        </div>\r\n        \r\n        <div class=\"call-options\">\r\n          <button \r\n            @click=\"createNewCall\" \r\n            class=\"btn btn-primary\"\r\n            :disabled=\"loading\"\r\n          >\r\n            {{ loading ? 'Creating...' : 'Start New Call' }}\r\n          </button>\r\n          \r\n          <div class=\"separator\">OR</div>\r\n          \r\n          <div class=\"join-form\">\r\n            <input \r\n              type=\"text\" \r\n              v-model=\"callId\" \r\n              placeholder=\"Enter call ID\"\r\n              class=\"call-id-input\"\r\n            />\r\n            <button \r\n              @click=\"joinCall(callId)\" \r\n              class=\"btn btn-secondary\"\r\n              :disabled=\"!callId || loading\"\r\n            >\r\n              {{ loading ? 'Joining...' : 'Join Call' }}\r\n            </button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n    \r\n    <!-- Active Call Interface -->\r\n    <div v-else class=\"active-call\">\r\n      <!-- Call Header -->\r\n      <div class=\"call-header\">\r\n        <div class=\"call-info\">\r\n          <h2>Active Call</h2>\r\n          <div v-if=\"currentCall\" class=\"call-id-display\">\r\n            ID: <span class=\"monospace\">{{ currentCall?.id || '' }}</span>\r\n            <button \r\n              @click=\"copyCallId\" \r\n              class=\"btn-icon\"\r\n              title=\"Copy call ID\"\r\n            >\r\n              📋\r\n            </button>\r\n          </div>\r\n        </div>\r\n        \r\n        <div class=\"user-controls\">\r\n          <div class=\"language-control\">\r\n            <label for=\"language-select\">Your language:</label>\r\n            <select \r\n              id=\"language-select\" \r\n              v-model=\"selectedLanguage\"\r\n              @change=\"changeLanguage($event)\"\r\n            >\r\n              <option \r\n                v-for=\"(name, code) in availableLanguages\" \r\n                :key=\"code\" \r\n                :value=\"code\"\r\n              >\r\n                {{ name }}\r\n              </option>\r\n            </select>\r\n          </div>\r\n          \r\n          <button @click=\"leaveCall\" class=\"btn btn-danger\">\r\n            End Call\r\n          </button>\r\n        </div>\r\n      </div>\r\n      \r\n      <!-- Main Call Area -->\r\n      <div class=\"call-content\">\r\n        <!-- Participants Section -->\r\n        <div class=\"participants-panel\">\r\n          <h3>Participants</h3>\r\n          \r\n          <div class=\"participants-list\">\r\n            <!-- Current User -->\r\n            <div class=\"participant current-user\">\r\n              <div class=\"avatar\">\r\n                {{ currentUser?.name?.charAt(0).toUpperCase() || '?' }}\r\n              </div>\r\n              <div class=\"details\">\r\n                <div class=\"name\">{{ currentUser?.name }} (You)</div>\r\n                <div class=\"language\">\r\n                  {{ getLanguageName(currentUser?.preferred_language) }}\r\n                </div>\r\n              </div>\r\n            </div>\r\n            \r\n            <!-- Other Participants -->\r\n            <div \r\n              v-for=\"(participant, index) in participants || []\" \r\n              :key=\"participant?.id || index\"\r\n              class=\"participant\"\r\n              v-if=\"participant?.id && currentUser?.id && participant.id !== currentUser.id\"\r\n            >\r\n              <div class=\"avatar\">\r\n                {{ (participant?.name || '?').charAt(0).toUpperCase() }}\r\n              </div>\r\n              <div class=\"details\">\r\n                <div class=\"name\">{{ participant?.name || 'Unknown User' }}</div>\r\n                <div class=\"language\">\r\n                  {{ getLanguageName(participant?.preferred_language || 'en') }}\r\n                </div>\r\n              </div>\r\n            </div>\r\n            \r\n            <div v-if=\"participants.length <= 1\" class=\"empty-state\">\r\n              No other participants yet. Share the call ID to invite others.\r\n            </div>\r\n          </div>\r\n        </div>\r\n        \r\n        <!-- Communication Area -->\r\n        <div class=\"communication-panel\">\r\n          <!-- Transcript History -->\r\n          <div class=\"transcript-history\">\r\n            <div \r\n              v-for=\"message in messages\" \r\n              :key=\"message.id\"\r\n              class=\"message\"\r\n              :class=\"{'own-message': message.sender === currentUser?.id}\"\r\n            >\r\n              <div class=\"message-header\">\r\n                <span class=\"sender-name\">{{ getSenderName(message.sender) }}</span>\r\n                <span class=\"timestamp\">{{ formatTime(message.timestamp) }}</span>\r\n              </div>\r\n              \r\n              <div class=\"message-content\">\r\n                <div class=\"original-text\">{{ message.originalText }}</div>\r\n                <div class=\"translated-text\">{{ message.translatedText }}</div>\r\n              </div>\r\n            </div>\r\n            \r\n            <div v-if=\"messages.length === 0\" class=\"empty-state\">\r\n              No messages yet. Start speaking to begin the conversation.\r\n            </div>\r\n          </div>\r\n          \r\n          <!-- Voice Controls -->\r\n          <div class=\"voice-controls\">\r\n            <!-- Live Transcription -->\r\n            <div v-if=\"transcription\" class=\"live-transcription\">\r\n              <div class=\"transcription-label\">Currently speaking:</div>\r\n              <div class=\"transcription-text\">\"{{ transcription }}\"</div>\r\n            </div>\r\n            \r\n            <!-- Audio Visualization -->\r\n            <div class=\"audio-meter\">\r\n              <div \r\n                class=\"audio-level\" \r\n                :style=\"{ width: `${audioLevels.input * 100}%` }\"\r\n              ></div>\r\n            </div>\r\n            \r\n            <!-- Control Buttons -->\r\n            <div class=\"control-buttons\">\r\n              <button \r\n                @click=\"toggleRecording\" \r\n                class=\"btn btn-speak\"\r\n                :class=\"{'active': isRecording}\"\r\n              >\r\n                {{ isRecording ? 'Stop Speaking' : 'Start Speaking' }}\r\n              </button>\r\n              \r\n              <button \r\n                @click=\"toggleMute\" \r\n                class=\"btn btn-mute\"\r\n                :class=\"{'muted': isMuted}\"\r\n              >\r\n                {{ isMuted ? 'Unmute' : 'Mute' }}\r\n              </button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'Call',\r\n  \r\n  data() {\r\n    return {\r\n      callId: null,\r\n      isCallActive: false,\r\n      showJoinScreen: true,\r\n      selectedLanguage: '',\r\n      targetLanguages: {},\r\n      transcription: '',\r\n      translations: [],\r\n      audioLevels: {\r\n        input: 0,\r\n        output: 0\r\n      },\r\n      error: null,\r\n      loading: false\r\n    }\r\n  },\r\n  \r\n  computed: {\r\n    currentUser() {\r\n      return this.$store.getters['user/currentUser']\r\n    },\r\n    \r\n    availableLanguages() {\r\n      return this.$store.getters['user/availableLanguages']\r\n    },\r\n    \r\n    currentCall() {\r\n      return this.$store.getters['call/currentCall']\r\n    },\r\n    \r\n    participants() {\r\n      return this.$store.getters['call/participants']\r\n    },\r\n    \r\n    messages() {\r\n      return this.$store.getters['call/messages']\r\n    },\r\n    \r\n    isAuthenticated() {\r\n      return this.$store.getters['user/isAuthenticated']\r\n    },\r\n    \r\n    isRecording() {\r\n      return this.$store.getters['audio/isRecording']\r\n    },\r\n    \r\n    isMuted() {\r\n      return this.$store.getters['audio/isMuted']\r\n    }\r\n  },\r\n  \r\n  created() {\r\n    // Load available languages if not already loaded\r\n    if (!Object.keys(this.availableLanguages || {}).length) {\r\n      this.$store.dispatch('user/fetchAvailableLanguages')\r\n    }\r\n    \r\n    // Create a user if none exists\r\n    this.ensureUserExists()\r\n    \r\n    // Set initial language to user's preferred language\r\n    if (this.currentUser) {\r\n      this.selectedLanguage = this.currentUser.preferred_language || 'en'\r\n    }\r\n    \r\n    // Check if we have a call ID in the route params\r\n    const { id } = this.$route.params\r\n    if (id) {\r\n      this.callId = id\r\n      this.joinCall(id)\r\n    }\r\n  },\r\n  \r\n  methods: {\r\n    /**\r\n     * Ensures a user exists before creating/joining a call\r\n     */\r\n    async ensureUserExists() {\r\n      if (!this.isAuthenticated) {\r\n        try {\r\n          console.log('Creating new user...')\r\n          // Create a default user\r\n          await this.$store.dispatch('user/createUser', { \r\n            name: 'User_' + Math.floor(Math.random() * 1000), \r\n            preferredLanguage: 'en'\r\n          })\r\n          // Make sure the user was created before trying to access properties\r\n          if (this.currentUser) {\r\n            console.log('User created successfully:', this.currentUser)\r\n            this.selectedLanguage = this.currentUser.preferred_language || 'en'\r\n          } else {\r\n            console.warn('User creation seemed to succeed but no user object is available')\r\n          }\r\n        } catch (error) {\r\n          console.error('Error creating user:', error)\r\n          this.$store.dispatch('notification/add', {\r\n            type: 'error',\r\n            message: 'Failed to create user profile: ' + (error.message || 'Unknown error')\r\n          })\r\n        }\r\n      } else {\r\n        console.log('User already exists:', this.currentUser)\r\n      }\r\n    },\r\n    async createNewCall() {\r\n      try {\r\n        this.error = null\r\n        this.loading = true\r\n        \r\n        // Ensure user is created before proceeding\r\n        await this.ensureUserExists()\r\n        \r\n        // Create a new call via store\r\n        const call = await this.$store.dispatch('call/createCall')\r\n        this.callId = call.id\r\n        \r\n        // Redirect to the call page with ID if not already there\r\n        if (this.$route.params.id !== call.id) {\r\n          this.$router.push(`/call/${call.id}`)\r\n        }\r\n        \r\n        // Set up audio for the call\r\n        this.isCallActive = true\r\n        this.$store.dispatch('audio/setupWebSocket', {\r\n          callId: call?.id,\r\n          userId: this.currentUser?.id\r\n        })\r\n        \r\n        // Show success notification\r\n        this.$store.dispatch('notification/add', {\r\n          type: 'success',\r\n          message: 'Call created successfully! Share the Call ID with others.'\r\n        })\r\n      } catch (error) {\r\n        console.error('Error creating call:', error)\r\n        this.error = 'Failed to create call. Please try again.'\r\n        this.$store.dispatch('notification/add', {\r\n          type: 'error',\r\n          message: 'Failed to create call: ' + (error.message || 'Unknown error')\r\n        })\r\n      } finally {\r\n        this.loading = false\r\n      }\r\n    },\r\n    \r\n    async joinCall(id) {\r\n      try {\r\n        this.error = null\r\n        this.loading = true\r\n        const callId = id || this.callId\r\n        \r\n        if (!callId) {\r\n          this.error = 'Please enter a valid Call ID'\r\n          return\r\n        }\r\n        \r\n        // Ensure user is created before proceeding\r\n        await this.ensureUserExists()\r\n        \r\n        // Join the call via store\r\n        await this.$store.dispatch('call/joinCall', callId)\r\n        \r\n        // Set up audio for the call\r\n        this.isCallActive = true\r\n        this.$store.dispatch('audio/setupWebSocket', {\r\n          callId: callId,\r\n          userId: this.currentUser?.id\r\n        })\r\n        \r\n        // Show success notification\r\n        this.$store.dispatch('notification/add', {\r\n          type: 'success',\r\n          message: 'Joined call successfully!'\r\n        })\r\n      } catch (error) {\r\n        console.error('Error joining call:', error)\r\n        this.error = 'Failed to join call. Please check the Call ID and try again.'\r\n        this.$store.dispatch('notification/add', {\r\n          type: 'error',\r\n          message: 'Failed to join call: ' + (error.message || 'Unknown error')\r\n        })\r\n      } finally {\r\n        this.loading = false\r\n      }\r\n    },\r\n    \r\n    leaveCall() {\r\n      // Clean up audio resources\r\n      this.$store.dispatch('audio/cleanupAudio')\r\n      \r\n      // Clear call state\r\n      this.$store.dispatch('call/leaveCall')\r\n      \r\n      // Reset local state\r\n      this.isCallActive = false\r\n      this.showJoinScreen = true\r\n      \r\n      // Go back to home page\r\n      this.$router.push('/')\r\n    },\r\n    \r\n    toggleRecording() {\r\n      if (this.isRecording) {\r\n        this.$store.dispatch('audio/stopRecording')\r\n      } else {\r\n        this.$store.dispatch('audio/startRecording')\r\n      }\r\n    },\r\n    \r\n    toggleMute() {\r\n      this.$store.dispatch('audio/toggleMute')\r\n    },\r\n    \r\n    changeLanguage(event) {\r\n      const language = event.target.value\r\n      this.$store.dispatch('user/updateUserLanguage', language)\r\n    },\r\n    \r\n    getLanguageName(code) {\r\n      return this.availableLanguages[code] || code\r\n    },\r\n    \r\n    getSenderName(senderId) {\r\n      if (senderId === this.currentUser?.id) {\r\n        return 'You'\r\n      }\r\n      \r\n      const participant = this.participants.find(p => p.id === senderId)\r\n      return participant ? participant.name : 'Unknown User'\r\n    },\r\n    \r\n    formatTime(timestamp) {\r\n      const date = new Date(timestamp)\r\n      return date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })\r\n    },\r\n    \r\n    copyCallId() {\r\n      if (this.currentCall || this.callId) {\r\n        navigator.clipboard.writeText(this.currentCall?.id || this.callId || '')\r\n          .then(() => {\r\n            // Show temporary notification\r\n            this.$store.dispatch('notification/add', {\r\n              type: 'success',\r\n              message: 'Call ID copied to clipboard!'\r\n            })\r\n          })\r\n          .catch(error => {\r\n            console.error('Error copying to clipboard:', error)\r\n            this.$store.dispatch('notification/add', {\r\n              type: 'error',\r\n              message: 'Failed to copy Call ID'\r\n            })\r\n          })\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.call-container {\r\n  width: 100%;\r\n  min-height: 80vh;\r\n  display: flex;\r\n  flex-direction: 